# QpiAI portals and credentials (real keys only in .env, never committed)
QCLOUD_PORTAL_URL=https://qcloud.qpiai.tech/
QCLOUD_URL=https://qcloud.qpiai.tech/
QCLOUD_API_KEY=

QPIAI_OPT_PORTAL_URL=https://opt.qpiai.tech/
QPIAI_OPT_URL=https://opt.qpiai.tech/
QPIAI_OPT_SERVER_URL=https://opt-server.qpiai.tech/api
QPIAI_OPT_API_KEY=
# Chain: local Anvil only. TEST KEYS are public; never fund them on a real network.
# If left blank, scripts/bootstrap_env.py fills owner/agent/verifier from Anvil's well-known dev accounts.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
OWNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
VENDOR_KEY_SEED=agentvault-test-seed
# Behaviour
DEMO_MODE=true
ADMIN_TOKEN=change-me
VERIFIER_URL=http://127.0.0.1:8001
APPROVAL_TTL_SECONDS=120
QUOTE_TTL_SECONDS=900
WASTE_TOLERANCE_BPS=1000
EXCESS_UNITS_MARGIN_BPS=1000
QAOA_MAX_QUBITS=12
LLM_PROVIDER=none
ALLOW_PUBLIC_TESTNET=false
